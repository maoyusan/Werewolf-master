# NapCat（OneBot 11）正向 WebSocket 地址，例如 ws://127.0.0.1:3001
NAPCAT_WS_URL=ws://127.0.0.1:3001
# NapCat 若配置了 token 就填在这里，没配就留空
NAPCAT_ACCESS_TOKEN=

# PostgreSQL only, for example postgresql://user:password@127.0.0.1:5432/werewolf
DATABASE_URL=

# Runtime
HOST=127.0.0.1
PORT=18100
GAME_MODE=Normal
DISABLED_ROLES=
REQUIRED_ROLES=
# 可执行 forcestart、管理员缩短等待时间的 QQ 用户 ID，多个用逗号分隔
ADMIN_USER_IDS=
# 官方 GlobalAdminOnly / DevOnly 命令（/permban、/killgame、/maintenance 等）的用户 ID
DEV_USER_IDS=
LOG_LEVEL=INFO
# 官方正式服最少 5 人。本地用 3 个号试玩可改成 3。
MIN_PLAYERS=5
JOIN_SECONDS=180
NIGHT_SECONDS=90
DAY_SECONDS=60
VOTE_SECONDS=90
ALLOW_FLEE=true
ALLOW_EXTEND=false
MAX_EXTEND=60
# 官方群规则开关。true 为开启，false 为关闭。
RANDOM_LYNCH=false
SECRET_LYNCH=false
SECRET_LYNCH_SHOW_VOTES=false
SECRET_LYNCH_SHOW_VOTERS=false
SHOW_ROLES_ON_DEATH=true
SHOW_ROLES_END=Living
THIEF_FULL=false
ALLOW_ARSONIST=true
BURNING_OVERKILL=false
RANDOM_MODE=false
SHOW_IDS=false
SHUFFLE_PLAYER_LIST=false
ALLOW_NSFW=false
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_POLL_SECONDS=2
